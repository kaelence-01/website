---
import { principles } from '../data/site';
---
<section id="approach" class="section dark" aria-labelledby="approach-title">
  <div class="wrap layout">
    <div class="side">
      <div class="eyebrow">Approach</div>
      <h2 id="approach-title">Problems first. Technologies second.</h2>
      <p>
        Go, Rust, Java, Python, AWS or Kubernetes are tools — never the limit of what we do. We stay
        technology agnostic and engineering opinionated.
      </p>
    </div>

    <ol class="list">
      {principles.map((p, i) => (
        <li>
          <span class="code">P/{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.name}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .layout { display: grid; grid-template-columns: 5fr 7fr; gap: 40px 72px; align-items: start; }
  .side { position: sticky; top: calc(var(--nav-h) + 40px); }
  h2 {
    margin-top: 14px;
    font-weight: 600; font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.1; letter-spacing: -.025em; text-wrap: balance;
  }
  .side p { margin-top: 20px; color: var(--soft); line-height: 1.7; max-width: 420px; }

  .list { border-top: 1px solid var(--line); }
  .list li {
    display: grid; grid-template-columns: 64px 180px 1fr; gap: 8px 20px; align-items: baseline;
    padding: 22px 0; border-bottom: 1px solid var(--line-soft);
  }
  .list .code { color: var(--cyan); }
  h3 { font-size: 18px; font-weight: 600; }
  .list p { color: var(--soft); font-size: 15.5px; line-height: 1.6; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 560px) {
    .list li { grid-template-columns: 56px 1fr; }
    .list p { grid-column: 2; }
  }
</style>
